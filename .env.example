# Copiar como .env.local (ignorado por git) y ajustar.
# Reiniciar `npx expo start` después de cambiar estas variables.

# mock = datos de prueba (no necesita backend ni Firebase) | http = backend cloud real
EXPO_PUBLIC_API_MODE=mock

# Backend cloud corriendo local (repo Backend, cloud/: uvicorn main:app --host 0.0.0.0).
# Desde el celular con Expo Go NO sirve "localhost": usar la IP de la PC en la red local.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8000

# mock = login en memoria (ver features/auth/README.md, "Estado: MOCK") | firebase = login real
EXPO_PUBLIC_AUTH_MODE=mock

# Config pública (no secreta) de la app web del proyecto de Firebase — Project Settings → General
# → "Your apps" → app web. Solo hace falta si EXPO_PUBLIC_AUTH_MODE=firebase.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
