# Copiar como .env.local (ignorado por git) y ajustar.
# Reiniciar `npx expo start` después de cambiar estas variables.

# mock = datos de prueba (no necesita backend ni Firebase) | http = backend cloud real
EXPO_PUBLIC_API_MODE=mock

# Backend cloud corriendo local (repo Backend, cloud/: uvicorn main:app --host 0.0.0.0).
# Desde el celular con Expo Go NO sirve "localhost": usar la IP de la PC en la red local.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
